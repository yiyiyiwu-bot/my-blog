---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const news = allNews.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
---

<BaseLayout title="最新資訊">
  <div class="wrap post-header">
    <h1 class="post-title">最新資訊</h1>
  </div>

  <div class="wrap">
    {news.length === 0 && <p class="empty-state">目前還沒有公告。</p>}

    <ol class="episode-list news-list">
      {news.map((item) => (
        <li>
          <a href={`/news/${item.id}/`}>
            <span class="news-date">
              {item.data.pinned && <span class="news-pinned">置頂</span>}
              {item.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="news-title">{item.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
