---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const blocks = await getCollection('home');
  return blocks.map((block) => ({
    params: { id: block.id },
    props: { block },
  }));
}

const { block } = Astro.props;
---

<BaseLayout title={block.data.title || '關於我們'}>
  <div class="wrap post-header">
    <h1 class="post-title">{block.data.title || '關於我們'}</h1>
    {block.data.pageIntro && (
      <div class="home-block-text home-block-text--markdown" set:html={marked.parse(block.data.pageIntro, { breaks: true })} />
    )}
  </div>

  {block.data.detailImage && (
    <img class="post-cover post-cover--full" src={block.data.detailImage} alt={block.data.title || ''} />
  )}
</BaseLayout>
