---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { renderMarkdown } from '../lib/markdown';

const contactPage = await getEntry('pages', 'contact');
const introHtml = contactPage?.data.intro
  ? renderMarkdown(contactPage.data.intro)
  : '';
---

<BaseLayout title={contactPage?.data.title || '聯絡我們'}>
  <div class="wrap post-header">
    <h1 class="post-title">{contactPage?.data.title || '聯絡我們'}</h1>
    {introHtml && <div class="post-meta contact-intro" set:html={introHtml} />}
    {contactPage?.data.qrImage && (
      <img class="contact-qr" src={contactPage.data.qrImage} alt="QR Code" />
    )}
  </div>
</BaseLayout>
