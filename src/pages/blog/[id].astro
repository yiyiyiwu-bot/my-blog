---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.pubDate.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const chapters = allPosts
  .filter((p) => p.data.category === post.data.category)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const chapterIndex = chapters.findIndex((p) => p.id === post.id);
const prevChapter = chapterIndex > 0 ? chapters[chapterIndex - 1] : null;
const nextChapter = chapterIndex < chapters.length - 1 ? chapters[chapterIndex + 1] : null;
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <div class="wrap post-header">
    <p class="post-category">
      <a href={`/articles/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
    </p>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-meta">{formattedDate}</p>
  </div>

  {post.data.password && (
    <div class="password-gate wrap" id="password-gate">
      {post.data.passwordHint && <p class="password-hint">{post.data.passwordHint}</p>}
      <div class="password-form">
        <input type="password" id="password-input" placeholder="請輸入密碼" />
        <button type="button" id="password-submit">確認</button>
      </div>
      <p class="password-error" id="password-error" hidden>密碼不對，再試一次</p>
    </div>
  )}

  <div id="protected-content" class={post.data.password ? 'is-locked' : ''}>
    {post.data.coverImage && (
      <img class="post-cover" src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} />
    )}

    <article class="post-body wrap">
      <Content />
    </article>

    {post.data.tags.length > 0 && (
      <div class="post-tags wrap">
        {post.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}

    <nav class="chapter-nav wrap">
      {prevChapter ? (
        <a class="chapter-link chapter-prev" href={`/blog/${prevChapter.id}/`}>
          <span class="chapter-label">← 上一章</span>
          <span class="chapter-title">{prevChapter.data.title}</span>
        </a>
      ) : (
        <span class="chapter-link chapter-prev is-disabled">
          <span class="chapter-label">← 上一章</span>
        </span>
      )}
      {nextChapter ? (
        <a class="chapter-link chapter-next" href={`/blog/${nextChapter.id}/`}>
          <span class="chapter-label">下一章 →</span>
          <span class="chapter-title">{nextChapter.data.title}</span>
        </a>
      ) : (
        <span class="chapter-link chapter-next is-disabled">
          <span class="chapter-label">下一章 →</span>
        </span>
      )}
    </nav>
  </div>

  {post.data.password && (
    <script define:vars={{ postId: post.id, encodedPassword: Buffer.from(post.data.password).toString('base64') }}>
      const KEY = `unlocked-${postId}`;
      const gate = document.getElementById('password-gate');
      const content = document.getElementById('protected-content');
      const input = document.getElementById('password-input');
      const submitBtn = document.getElementById('password-submit');
      const error = document.getElementById('password-error');

      function unlock() {
        gate.style.display = 'none';
        content.classList.remove('is-locked');
      }

      if (sessionStorage.getItem(KEY) === '1') {
        unlock();
      }

      function tryUnlock() {
        if (input.value === atob(encodedPassword)) {
          sessionStorage.setItem(KEY, '1');
          error.hidden = true;
          unlock();
        } else {
          error.hidden = false;
        }
      }

      submitBtn.addEventListener('click', tryUnlock);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') tryUnlock();
      });
    </script>
  )}
</BaseLayout>
