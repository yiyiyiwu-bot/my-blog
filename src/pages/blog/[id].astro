---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.pubDate.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const chapters = allPosts
  .filter((p) => p.data.category === post.data.category)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const chapterIndex = chapters.findIndex((p) => p.id === post.id);
const prevChapter = chapterIndex > 0 ? chapters[chapterIndex - 1] : null;
const nextChapter = chapterIndex < chapters.length - 1 ? chapters[chapterIndex + 1] : null;
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <div class="wrap post-header">
    <p class="post-category">
      <a href={`/articles/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
    </p>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-meta">{formattedDate}</p>
  </div>

  <article class={`post-body wrap font-${post.data.fontFamily} size-${post.data.fontSize}`}>
    <Content />
  </article>

  {post.data.coverImage && (
    <img class="post-cover post-cover--full" src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} />
  )}

  {post.data.coverImage2 && (
    <img class="post-cover post-cover--full" src={post.data.coverImage2} alt={post.data.coverImageAlt || post.data.title} />
  )}

  {post.data.tags.length > 0 && (
    <div class="post-tags wrap">
      {post.data.tags.map((tag) => <span>{tag}</span>)}
    </div>
  )}

  <nav class="chapter-nav wrap">
    {prevChapter ? (
      <a class="chapter-link chapter-prev" href={`/blog/${prevChapter.id}/`}>
        <span class="chapter-label">← 上一章</span>
        <span class="chapter-title">{prevChapter.data.title}</span>
      </a>
    ) : (
      <span class="chapter-link chapter-prev is-disabled">
        <span class="chapter-label">← 上一章</span>
      </span>
    )}
    {nextChapter ? (
      <a class="chapter-link chapter-next" href={`/blog/${nextChapter.id}/`}>
        <span class="chapter-label">下一章 →</span>
        <span class="chapter-title">{nextChapter.data.title}</span>
      </a>
    ) : (
      <span class="chapter-link chapter-next is-disabled">
        <span class="chapter-label">下一章 →</span>
      </span>
    )}
  </nav>

  <div class="wrap post-comments">
    <h2 class="section-title">留言</h2>

    <form id="comment-form" class="comment-form">
      <input type="text" id="comment-name" name="name" class="comment-input" placeholder="你的名字" maxlength="50" required />
      <textarea id="comment-body" name="body" class="comment-textarea" placeholder="留言內容" maxlength="2000" required></textarea>
      <input type="text" id="comment-website" name="website" class="comment-honeypot" tabindex="-1" autocomplete="off" />
      <button type="submit" class="comment-submit">送出留言</button>
      <p class="comment-status" id="comment-status" hidden></p>
    </form>

    <ol class="comment-list" id="comment-list"></ol>
  </div>

  <script define:vars={{ postId: post.id }}>
    const form = document.getElementById('comment-form');
    const list = document.getElementById('comment-list');
    const status = document.getElementById('comment-status');

    function renderComment(c, index) {
      const li = document.createElement('li');
      li.className = 'comment-item';

      const name = document.createElement('p');
      name.className = 'comment-name';
      name.textContent = c.name;

      const body = document.createElement('p');
      body.className = 'comment-body-text';
      body.textContent = c.body;

      const meta = document.createElement('p');
      meta.className = 'comment-meta-line';
      const dateStr = new Date(c.created_at).toLocaleDateString('zh-TW', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      meta.textContent = `${index + 1}F，${dateStr}`;

      li.appendChild(name);
      li.appendChild(body);
      li.appendChild(meta);
      return li;
    }

    async function loadComments() {
      try {
        const res = await fetch(`/api/comments?postId=${encodeURIComponent(postId)}`);
        const data = await res.json();
        list.innerHTML = '';
        if (!data.comments || data.comments.length === 0) {
          const empty = document.createElement('li');
          empty.className = 'comment-empty';
          empty.textContent = '目前還沒有留言，當第一個留言的人吧！';
          list.appendChild(empty);
          return;
        }
        data.comments.forEach((c, i) => list.appendChild(renderComment(c, i)));
      } catch {
        list.innerHTML = '<li class="comment-empty">留言載入失敗，請稍後再試。</li>';
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('comment-name').value.trim();
      const body = document.getElementById('comment-body').value.trim();
      const website = document.getElementById('comment-website').value.trim();
      if (!name || !body) return;

      status.hidden = true;
      const submitBtn = form.querySelector('.comment-submit');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ postId, name, body, website }),
        });
        const data = await res.json();
        if (!res.ok) {
          status.textContent = data.error || '送出失敗，請再試一次';
          status.hidden = false;
        } else {
          form.reset();
          await loadComments();
        }
      } catch {
        status.textContent = '送出失敗，請確認網路連線後再試一次';
        status.hidden = false;
      } finally {
        submitBtn.disabled = false;
      }
    });

    loadComments();
  </script>
</BaseLayout>
