---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="生命模擬器" description="在人間做選擇、收集卡片，死後用卡片通過中陰身的考驗。">
  <section class="game-wrap">
    <div class="game" id="game" data-scene="title">
      <div class="game-stage" id="game-stage"></div>
      <div class="game-hand" id="game-hand" hidden></div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    cards,
    chapters,
    trials,
    evilRealms,
    EVIL_THRESHOLD,
    heavenRealm,
    humanRealm,
    HEAVEN_MERIT,
    MERIT_NEEDED,
    MERIT_COST,
    stages,
    lifePlans,
    howToPlay,
    DISCLAIMER,
    type Chapter,
    type RealmId,
    type Stage,
    type StageId,
  } from '../game/data';
  import { roles, SHEET, SHEET_COLS, TILE, type Role } from '../game/world';

  const game = document.getElementById('game')!;
  const stage = document.getElementById('game-stage')!;
  const handEl = document.getElementById('game-hand')!;

  // 一輩子的狀態（陰德 merit 不顯示給玩家）
  let life = 1;
  let merit = 0;
  let age = 0;
  let hand: string[] = [];
  // 這一世接下來的每一回：故事、屬於哪個階段、那時幾歲
  let deck: Slot[] = [];
  let currentStage: Stage | null = null;
  let lastStep = 0; // 最後一回之後再過幾年才走
  let pendingKarma: string | null = null;
  // 這一世在各道累積的分數（小壞 1 分、會折壽的大惡 2 分）
  const emptyScore = (): Record<RealmId, number> => ({ hell: 0, ghost: 0, animal: 0, asura: 0 });
  let realmScore = emptyScore();
  let round = 0; // 這一世玩到第幾回
  let lostRounds = 0; // 這一世因折壽少掉的回數
  let deathMerit = 0; // 死的時候的陰德，決定沒過關時去天道還是人道
  let trialIndex = 0;
  type Slot = { chapter: Chapter; stage: Stage; age: number; step: number };
  let rolePicked: Role | null = null; // 這一世選的職業
  function shuffle<T>(list: T[]): T[] {
    const a = [...list];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function show(scene: string, html: string, showHand = false, bg?: string) {
    game.dataset.scene = scene;
    // 這個階段有背景圖的話，放進遊戲框的背景
    if (bg) {
      game.style.setProperty('--stage-bg', `url("${bg}")`);
      game.dataset.bg = '';
    } else {
      game.style.removeProperty('--stage-bg');
      delete game.dataset.bg;
    }
    stage.innerHTML = html;
    handEl.hidden = !showHand;
    if (showHand) renderHand();
    game.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderHand() {
    handEl.innerHTML = hand.length
      ? `<span class="game-hand-label">手上的卡片</span>` +
        hand.map((id) => `<img src="${cards[id].img}" alt="${cards[id].name}" title="${cards[id].name}" />`).join('')
      : `<span class="game-hand-label">手上還沒有卡片</span>`;
  }

  // 把用空行分開的文字變成好幾個段落
  function paras(text: string) {
    return text
      .split('\n\n')
      .map((p) => `<p class="game-text">${p}</p>`)
      .join('');
  }

  function button(label: string, action: string, extra = '') {
    return `<button type="button" class="game-btn" data-action="${action}" ${extra}>${label}</button>`;
  }

  function cardFigure(id: string) {
    const c = cards[id];
    return `<figure class="game-card">
      <img src="${c.img}" alt="${c.name}" />
      <figcaption><strong>${c.name}</strong><span>${c.quote}</span></figcaption>
    </figure>`;
  }

  // ---------- 畫面 ----------

  function titleScreen() {
    show(
      'title',
      `<h1 class="game-title">生命模擬器</h1>
       <p class="game-lead">導師「愛、光和良知」看著你說：<br />「去人間好好體驗吧。記得，每一個選擇都算數。」</p>
       <p class="game-motto">選項沒有絕對的對錯，<br />提供給你的慣性另一個選項，<br />在一次又一次的過程，<br />學會祝福想要讓我們懂得的。</p>
       <p class="game-meta game-center">${life > 1 ? `第 ${life} 世，` : ''}你想從哪裡開始投胎？</p>
       <div class="game-starts">
         ${stages
           .map(
             (s) => `<button type="button" class="game-btn game-start" data-action="pick-stage" data-stage="${s.id}">
               <strong>${s.name}</strong><span>${s.startAge} 歲起 · ${s.blurb}</span>
             </button>`,
           )
           .join('')}
       </div>`,
    );
  }

  // 選好起點之後的第二頁：玩法介紹，看完再開始
  function howToPlayScreen(from: StageId) {
    const s = stages.find((x) => x.id === from)!;
    show(
      'title',
      `<h2 class="game-heading">玩法介紹</h2>
       <p class="game-meta">你選擇從「${s.name}」開始投胎。</p>
       ${howToPlay.map((h) => `<section class="game-rule"><h3>${h.title}</h3>${paras(h.text)}</section>`).join('')}
       <p class="game-disclaimer">${DISCLAIMER}</p>
       ${button('開始投胎', 'start', `data-stage="${s.id}"`)}
       ${button('重新選起點', 'title', 'data-variant="link"')}`,
    );
  }

  // 照 lifePlans 從 from 這個起點排出這一世的每一回
  function startLife(from: StageId) {
    hand = [];
    deck = [];
    const used = new Set<Chapter>();
    for (const [stageId, rounds] of lifePlans[from]) {
      const s = stages.find((x) => x.id === stageId)!;
      const step = Math.floor((s.endAge - s.startAge + 1) / rounds);
      // 職業專屬的故事不在這裡抽，等選了職業才換進來（pickRole）
      const general = chapters.filter((c) => !c.roles && !used.has(c));
      const pool = shuffle(general.filter((c) => c.stage === stageId)).slice(0, rounds);
      // 這個階段的故事還不夠時，暫時借用其他階段的故事補滿
      const extra = shuffle(general.filter((c) => c.stage !== stageId && !pool.includes(c)));
      while (pool.length < rounds && extra.length) pool.push(extra.pop()!);
      pool.forEach((chapter, i) => {
        used.add(chapter);
        deck.push({ chapter, stage: s, age: s.startAge + i * step, step });
      });
    }
    currentStage = null;
    pendingKarma = null;
    realmScore = emptyScore();
    round = 0;
    lostRounds = 0;
    rolePicked = null;
    nextChapter();
  }

  function nextChapter() {
    const next = deck[0];
    if (!next) return currentStage?.ending ? endingScreen(currentStage) : deathScreen();
    // 進入有角色可以選的階段時，先選這輩子的工作
    if (!rolePicked && roles.some((r) => r.stage === next.stage.id)) return roleScreen(next.stage);
    playSlot(deck.shift()!);
  }

  function playSlot(next: Slot) {
    const { chapter } = next;
    const newStage = next.stage !== currentStage;
    currentStage = next.stage;
    age = next.age;
    lastStep = next.step;
    round++;
    const karma = pendingKarma;
    pendingKarma = null;
    show(
      'life',
      `${newStage ? `<p class="game-stage-banner">${next.stage.name}</p>` : ''}
       <p class="game-meta">第 ${life} 世 · ${next.stage.name}${rolePicked?.stage === next.stage.id ? ` · ${rolePicked.name}` : ''} · ${age} 歲 · 第 ${round} 回</p>
       ${karma ? `<div class="game-karma"><strong>因果</strong>${karma}</div>` : ''}
       <div class="game-heading-row">
         <h2 class="game-heading">${chapter.title}</h2>
         <button type="button" class="game-help" data-action="help" aria-expanded="false">停看聽</button>
       </div>
       <div class="game-hint" id="game-hint" hidden>
         <p class="game-hint-lead">停、看、聽，是心的引路人。</p>
         <p class="game-hint-quote">「${chapter.hint.quote}」</p>
         <p class="game-hint-source">——${chapter.hint.source}</p>
       </div>
       ${chapter.image ? `<img class="game-story-img" src="${chapter.image}" alt="" />` : ''}
       ${paras(chapter.text)}
       <div class="game-choices">
         ${shuffle(chapter.choices.map((c, i) => button(c.text, 'choose', `data-chapter="${chapter.id}" data-index="${i}"`))).join('')}
       </div>`,
      true,
      next.stage.background,
    );
  }

  function choose(chapterId: string, index: number) {
    const chapter = chapters.find((c) => c.id === chapterId)!;
    const choice = chapter.choices[index];
    merit += choice.merit;
    const gained = choice.cards ?? [];
    hand.push(...gained);
    if (choice.karma) pendingKarma = choice.karma;
    if (choice.realm) realmScore[choice.realm] += choice.shorten ? 2 : 1;
    // 大惡折壽：直接抽掉後面的回數
    const cut = choice.shorten ? deck.splice(0, choice.shorten).length : 0;
    lostRounds += cut;
    show(
      'life',
      `${paras(choice.result)}
       ${cut ? `<p class="game-shorten">⏳ 惡業折壽：這一生少了 ${cut} 回。</p>` : ''}
       ${gained.length ? `<p class="game-meta">你得到了卡片</p><div class="game-cards">${gained.map(cardFigure).join('')}</div>` : ''}
       ${chapter.epilogue ? `<div class="game-epilogue"><p class="game-meta">後來……</p>${paras(chapter.epilogue)}</div>` : ''}
       ${button('繼續', 'next-chapter')}`,
      true,
      currentStage?.background,
    );
  }

  // 人物圖（從圖塊表裁一塊，放大 3 倍，面向下）
  function spriteDiv(sprite: number) {
    const i = sprite + 1;
    const x = (i % SHEET_COLS) * TILE * 3;
    const y = Math.floor(i / SHEET_COLS) * TILE * 3;
    return `<span class="game-sprite" style="background-image:url(${SHEET});background-position:-${x}px -${y}px"></span>`;
  }

  function roleScreen(s: Stage) {
    show(
      'life',
      `<p class="game-stage-banner">${s.name}</p>
       <h2 class="game-heading game-center">這輩子，你想做什麼工作？</h2>
       <div class="game-roles">
         ${roles
           .filter((r) => r.stage === s.id)
           .map(
             (r) => `<button type="button" class="game-role" data-action="pick-role" data-role="${r.id}" ${r.ready ? '' : 'disabled'}>
               ${spriteDiv(r.sprite)}<strong>${r.name}</strong><span>${r.ready ? r.blurb : '準備中'}</span>
             </button>`,
           )
           .join('')}
       </div>`,
      true,
    );
  }

  function pickRole(id: string) {
    const role = roles.find((r) => r.id === id)!;
    rolePicked = role;
    // 這個職業有專屬故事的話，優先換進這個階段的回數裡（年紀照原本的安排）
    const here = deck.filter((s) => s.stage === deck[0].stage);
    const own = shuffle(chapters.filter((c) => c.roles?.includes(role.id)));
    for (const slot of here) {
      if (!own.length) break;
      slot.chapter = own.pop()!;
    }
    nextChapter();
  }

  // 這一組玩完的結局頁（還沒寫內容時先留白）
  function endingScreen(s: Stage) {
    const ending = s.ending!;
    const karma = pendingKarma;
    pendingKarma = null;
    show(
      'life',
      `${karma ? `<div class="game-karma"><strong>因果</strong>${karma}</div>` : ''}
       <h2 class="game-heading">${ending.title}</h2>
       ${ending.text ? paras(ending.text) : '<div class="game-ending-blank"></div>'}
       ${button('回到開始', 'title')}`,
      true,
      s.background,
    );
  }

  function deathScreen() {
    age += lastStep;
    const karma = pendingKarma;
    pendingKarma = null;
    const total = Object.values(realmScore).reduce((a, b) => a + b, 0);
    const forced = total >= EVIL_THRESHOLD;
    show(
      'death',
      `${karma ? `<div class="game-karma"><strong>因果</strong>${karma}</div>` : ''}
       <h2 class="game-heading">人生落幕</h2>
       <p class="game-text">${
         lostRounds
           ? `${age} 歲那年，你的人生提早落幕了。原本還能再走好長一段路，卻被自己的惡業折去了。`
           : `${age} 歲那年，你慢慢閉上了眼睛。`
       }這一生的點點滴滴，像電影一樣在眼前播放……</p>
       ${
         forced
           ? `<p class="game-text">你還來不及看清楚四周，一股又沉又冷的力量就把你往下拉——這一生的惡業太重了，手上的卡片一張也拿不出來。</p>
              ${button('……', 'evil')}`
           : button('進入中陰身', 'bardo')
       }`,
      true,
    );
  }

  function evilScreen() {
    // 分數最高的那一道；evilRealms 由重到輕排，同分時取前面（較重）的
    const realm = evilRealms.reduce((best, r) => (realmScore[r.id] > realmScore[best.id] ? r : best));
    show(
      'evil',
      `<p class="game-meta">強制投胎</p>
       <h2 class="game-heading">${realm.name}</h2>
       ${paras(realm.text)}
       <p class="game-meta">受報期滿，你又得到了一次做人的機會。</p>
       ${button('重新做人', 'evil-rebirth')}`,
    );
  }

  function evilRebirth() {
    life++;
    // 惡業已經在惡道受完了，陰德從零開始
    merit = 0;
    // 回到開始畫面，重新選這一世的起點
    titleScreen();
  }

  function bardoIntro() {
    trialIndex = 0;
    deathMerit = merit;
    show(
      'bardo',
      `<h2 class="game-heading">中陰身</h2>
       <p class="game-text">你離開了身體，整個人輕飄飄的，比減肥成功還要輕。四周灰濛濛的，分不清白天還是黑夜，而且——沒有網路。</p>
       <p class="game-text">手上的卡片發著微微的光。接下來的路，要靠你自己。</p>
       ${button('往前走', 'trial')}`,
      true,
    );
  }

  function trialScreen() {
    const trial = trials[trialIndex];
    const unique = [...new Set(hand)];
    show(
      'bardo',
      `<p class="game-meta">考驗 ${trialIndex + 1} / ${trials.length}</p>
       <h2 class="game-heading">${trial.title}</h2>
       ${paras(trial.text)}
       ${unique.length ? `<p class="game-meta">要用哪一張卡片面對它？</p>` : ''}
       <div class="game-pick">
         ${unique
           .map(
             (id) => `<button type="button" class="game-pick-card" data-action="use-card" data-card="${id}">
               <img src="${cards[id].img}" alt="" /><span>${cards[id].name}</span>
             </button>`,
           )
           .join('')}
       </div>
       ${button('不用卡片，憑自己的心', 'use-card', 'data-card=""')}`,
      true,
    );
  }

  function useCard(cardId: string) {
    const trial = trials[trialIndex];
    let passed = false;
    let note = '';
    if (cardId) hand.splice(hand.indexOf(cardId), 1);
    if (cardId && trial.counters.includes(cardId)) {
      passed = true;
      note = `「${cards[cardId].name}」的光包圍著你。`;
    } else {
      if (cardId) note = `「${cards[cardId].name}」的光閃了一下就熄了，好像不是這張卡……`;
      // 沒有對的卡片，只能靠一生累積的陰德撐過去
      if (merit >= MERIT_NEEDED) {
        passed = true;
        merit -= MERIT_COST;
        note += (note ? '<br />' : '') + '你想起這一生做過的好事，心裡慢慢安定下來。';
      }
    }
    trialIndex++;
    const last = trialIndex >= trials.length;
    show(
      'bardo',
      `${note ? `<p class="game-meta">${note}</p>` : ''}
       ${paras(passed ? trial.pass : trial.fail)}
       ${passed ? button(last ? '繼續' : '繼續往前走', last ? 'liberate' : 'trial') : button('……', 'reincarnate')}`,
      true,
    );
  }

  // 中陰身沒過關：陰德夠多去天道，不然回人道
  function reincarnateScreen() {
    const heaven = deathMerit >= HEAVEN_MERIT;
    const realm = heaven ? heavenRealm : humanRealm;
    show(
      heaven ? 'heaven' : 'reborn',
      `<p class="game-meta">輪迴</p>
       <h2 class="game-heading">${realm.name}</h2>
       ${paras(realm.text)}
       <p class="game-meta">${realm.note}</p>
       ${button(realm.button, heaven ? 'heaven-fall' : 'rebirth')}`,
    );
  }

  function rebirth() {
    life++;
    // 好的陰德留一半到下一世，惡業則全部跟著你
    merit = merit > 0 ? Math.floor(merit / 2) : merit;
    // 回到開始畫面，重新選這一世的起點
    titleScreen();
  }

  function heavenFall() {
    life++;
    // 福報在天上享盡了
    merit = 0;
    // 回到開始畫面，重新選這一世的起點
    titleScreen();
  }

  function liberationScreen() {
    show(
      'free',
      `<h2 class="game-heading">解脫</h2>
       <p class="game-text">你走進了一片溫暖明亮的光裡。導師「愛、光和良知」在那裡等你，微笑著說：「歡迎回來。」</p>
       <p class="game-meta">你一共經歷了 ${life} 世</p>
       ${button('重新開始', 'restart')}`,
    );
  }

  stage.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
    if (!btn) return;
    switch (btn.dataset.action) {
      case 'start':
        return startLife(btn.dataset.stage as StageId);
      case 'pick-stage':
        return howToPlayScreen(btn.dataset.stage as StageId);
      case 'title':
        return titleScreen();
      case 'choose':
        return choose(btn.dataset.chapter!, Number(btn.dataset.index));
      case 'next-chapter':
        return nextChapter();
      case 'pick-role':
        return pickRole(btn.dataset.role!);
      case 'help': {
        const hint = document.getElementById('game-hint')!;
        hint.hidden = !hint.hidden;
        btn.setAttribute('aria-expanded', String(!hint.hidden));
        return;
      }
      case 'bardo':
        return bardoIntro();
      case 'evil':
        return evilScreen();
      case 'evil-rebirth':
        return evilRebirth();
      case 'trial':
        return trialScreen();
      case 'use-card':
        return useCard(btn.dataset.card ?? '');
      case 'reincarnate':
        return reincarnateScreen();
      case 'rebirth':
        return rebirth();
      case 'heaven-fall':
        return heavenFall();
      case 'liberate':
        return liberationScreen();
      case 'restart':
        life = 1;
        merit = 0;
        return titleScreen();
    }
  });

  titleScreen();
</script>

<style is:global>
  .game-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 16px 64px;
  }
  .game {
    position: relative;
    min-height: 70vh;
    border-radius: 12px;
    overflow: hidden;
    color: #fff;
    background: #2b2620 center / cover no-repeat;
    font-family: var(--font-serif);
    display: flex;
    flex-direction: column;
    scroll-margin-top: 16px;
  }
  .game::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 10, 0.55);
  }
  .game[data-scene='title'],
  .game[data-scene='reborn'] {
    background-image: url('/game/heaven-2.jpg');
  }
  .game[data-scene='free'] {
    background-image: url('/game/heaven-1.jpg');
  }
  .game[data-scene='life'] {
    background: linear-gradient(160deg, #6b5338, #3a2c1e);
  }
  .game[data-scene='life'][data-bg] {
    /* 靠下對齊：露出校園和街景，避開海報上方的大標題 */
    background: #2b2620 var(--stage-bg) center bottom / cover no-repeat;
  }
  .game[data-scene='life'][data-bg]::before {
    background: rgba(20, 16, 10, 0.76);
  }
  .game[data-scene='death'] {
    background: linear-gradient(160deg, #3d3a38, #1c1a19);
  }
  .game[data-scene='heaven'] {
    background: radial-gradient(circle at 50% 20%, #b8862b, #4a3412);
  }
  .game[data-scene='evil'] {
    background: radial-gradient(circle at 50% 80%, #6e1a12, #1a0806);
  }
  .game[data-scene='bardo'] {
    background: radial-gradient(circle at 50% 30%, #3b3f52, #101118);
  }
  .game-stage,
  .game-hand {
    position: relative;
  }
  .game-stage {
    flex: 1;
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }
  .game-title {
    font-size: 2.4rem;
    letter-spacing: 0.2em;
    text-align: center;
    margin: 0;
  }
  .game-lead {
    text-align: center;
    line-height: 2;
    margin: 0;
  }
  .game-motto {
    margin: 0;
    text-align: center;
    font-size: 0.95rem;
    line-height: 2;
    letter-spacing: 0.08em;
    color: #f3d98b;
  }
  .game-heading {
    font-size: 1.6rem;
    letter-spacing: 0.1em;
    margin: 0;
  }
  .game-center {
    text-align: center;
  }
  .game-starts {
    display: flex;
