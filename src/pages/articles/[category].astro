---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategorySidebar from '../../components/CategorySidebar.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((cat) => ({
    params: { category: cat.data.title },
    props: { categoryEntry: cat },
  }));
}

const { category } = Astro.params;
const { categoryEntry } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .filter((post) => post.data.category === category)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<BaseLayout title={category}>
  <div class="wrap articles-layout">
    <CategorySidebar active={category} />
    <div class="articles-main">
      <h1 class="articles-title">{category}</h1>

      {categoryEntry.data.password && (
        <div class="password-gate" id="password-gate">
          {categoryEntry.data.passwordHint && (
            <div class="password-hint" set:html={marked.parse(categoryEntry.data.passwordHint, { breaks: true })} />
          )}
          <div class="password-form">
            <input type="password" id="password-input" placeholder="請輸入密碼" />
            <button type="button" id="password-submit">確認</button>
          </div>
          <p class="password-error" id="password-error" hidden>密碼不對，再試一次</p>
        </div>
      )}

      <div id="protected-content" class={categoryEntry.data.password ? 'is-locked' : ''}>
        {categoryEntry.data.description && (
          <div class="articles-intro" set:html={marked.parse(categoryEntry.data.description, { breaks: true })} />
        )}

        <div class="episode-list-header">
          <h2 class="section-title">集數</h2>
          <button type="button" id="sort-toggle" class="sort-toggle">舊 → 新</button>
        </div>

        {posts.length === 0 && <p class="empty-state">這個分類還沒有文章。</p>}

        <ol class="episode-list" id="episode-list">
          {posts.map((post) => (
            <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const btn = document.getElementById('sort-toggle');
  const list = document.getElementById('episode-list');
  let reversed = false;
  btn?.addEventListener('click', () => {
    reversed = !reversed;
    list?.classList.toggle('is-reversed', reversed);
    if (btn) btn.textContent = reversed ? '新 → 舊' : '舊 → 新';
  });
</script>

{categoryEntry.data.password && (
  <script define:vars={{ categoryId: categoryEntry.id, encodedPassword: Buffer.from(categoryEntry.data.password).toString('base64') }}>
    const KEY = `unlocked-category-${categoryId}`;
    const gate = document.getElementById('password-gate');
    const content = document.getElementById('protected-content');
    const input = document.getElementById('password-input');
    const submitBtn = document.getElementById('password-submit');
    const error = document.getElementById('password-error');

    function unlock() {
      gate.style.display = 'none';
      content.classList.remove('is-locked');
    }

    if (sessionStorage.getItem(KEY) === '1') {
      unlock();
    }

    function tryUnlock() {
      if (input.value === atob(encodedPassword)) {
        sessionStorage.setItem(KEY, '1');
        error.hidden = true;
        unlock();
      } else {
        error.hidden = false;
      }
    }

    submitBtn.addEventListener('click', tryUnlock);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') tryUnlock();
    });
  </script>
)}
