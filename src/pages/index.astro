---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBlock from '../components/HomeBlock.astro';
import { siteConfig } from '../site.config';
import { getCollection, getEntry } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const heroPost = posts[0];

const homeIntro = await getEntry('pages', 'home-intro');
const homeBlocks = (await getCollection('home')).sort((a, b) => a.data.order - b.data.order);

const hasHeroImages = siteConfig.heroImages && siteConfig.heroImages.length > 0;
const hasCustomHero = !!siteConfig.heroVideo || hasHeroImages;
---

<BaseLayout overlayHeader={hasCustomHero}>
  <div
    class={`hero ${hasCustomHero || heroPost?.data.coverImage ? '' : 'hero-placeholder'}`}
    style={!hasCustomHero && heroPost?.data.coverImage ? `background-image: url(${heroPost.data.coverImage})` : ''}
  >
    {siteConfig.heroVideo && (
      <video class="hero-video" src={siteConfig.heroVideo} autoplay muted loop playsinline />
    )}
    {!siteConfig.heroVideo && hasHeroImages && (
      <div class="hero-slideshow">
        {siteConfig.heroImages.map((img) => (
          <img class={`hero-slide hero-slide--${img.fit}`} src={img.src} alt="" />
        ))}
      </div>
    )}
    <div class="hero-overlay">
      <div class="wrap">
        <p class="hero-tagline">{siteConfig.tagline}</p>
        <p class="hero-sub">{siteConfig.description}</p>
      </div>
    </div>
  </div>

  {!siteConfig.heroVideo && hasHeroImages && (
    <script>
      const KEY = 'heroImgIdx';
      const slides = document.querySelectorAll('.hero-slide');
      if (slides.length > 0) {
        let idx = parseInt(localStorage.getItem(KEY) || '0', 10);
        if (Number.isNaN(idx) || idx < 0 || idx >= slides.length) idx = 0;
        slides[idx].classList.add('is-active');
        localStorage.setItem(KEY, String((idx + 1) % slides.length));
      }
    </script>
  )}

  {homeIntro && (homeIntro.data.title || homeIntro.data.intro) && (
    <div class="wrap home-intro">
      {homeIntro.data.title && <h2 class="home-intro-title">{homeIntro.data.title}</h2>}
      {homeIntro.data.intro && <p class="home-intro-text">{homeIntro.data.intro}</p>}
    </div>
  )}

  {homeBlocks.map((block, i) => (
    (block.data.title || block.data.homeText) && (
      <>
        {i > 0 && (
          <div class="section-divider">
            <span class="flow-rule"></span>
          </div>
        )}
        <div class="wrap">
          <HomeBlock
            title={block.data.title}
            homeText={block.data.homeText}
            image={block.data.image}
            imagePosition={block.data.imagePosition}
            href={block.data.linkUrl || `/about/${block.id}`}
          />
        </div>
      </>
    )
  ))}
</BaseLayout>
