---
import '../styles/global.css';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
}

const { title, description = siteConfig.description, overlayHeader = false } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 fill=%22white%22/><path d=%22M16 30 Q13 18 16 4 Q19 18 16 30 Z%22 fill=%22%23d4a017%22/><path d=%22M16 30 Q10 20 7 10 Q13 21 16 30 Z%22 fill=%22%23d4a017%22/><path d=%22M16 30 Q22 20 25 10 Q19 21 16 30 Z%22 fill=%22%23d4a017%22/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="X1zo8jOPDQcbg_NXczH1NZ842VDHcjrz8vTfy_pm-Hk" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class={overlayHeader ? 'site-header site-header--overlay' : 'site-header'}>
      <div class="wrap">
        <a class="site-title" href="/">{siteConfig.title}</a>
        <nav class="site-nav">
          {siteConfig.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} {siteConfig.title}</span>
        <a href="/admin/">後台登入</a>
      </div>
    </footer>

    <div class="floating-nav">
      <div class="font-scale-control">
        <button type="button" id="font-scale-toggle" class="floating-nav-btn" aria-label="調整文字大小" aria-expanded="false">
          <span class="floating-nav-text">文字大小</span>
        </button>
        <div class="font-scale-options" id="font-scale-options" hidden>
          <button type="button" class="font-scale-btn" data-scale="0.85">小</button>
          <button type="button" class="font-scale-btn" data-scale="1">中</button>
          <button type="button" class="font-scale-btn" data-scale="1.2">大</button>
          <button type="button" class="font-scale-btn" data-scale="1.4">巨</button>
        </div>
      </div>
      <button type="button" id="back-to-top" class="floating-nav-btn" aria-label="回到頂端">
        <span class="floating-nav-icon">↑</span>
        <span class="floating-nav-text">頂端</span>
      </button>
      <a href="/" class="floating-nav-btn" aria-label="回首頁">
        <span class="floating-nav-icon">⌂</span>
        <span class="floating-nav-text">首頁</span>
      </a>
    </div>

    <script>
      document.getElementById('back-to-top')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      const floatingNav = document.querySelector('.floating-nav');
      const toggleFloatingNav = () => {
        floatingNav?.classList.toggle('is-visible', window.scrollY > 200);
      };
      toggleFloatingNav();
      window.addEventListener('scroll', toggleFloatingNav, { passive: true });

      const SCALE_KEY = 'globalFontScale';
      const scaleButtons = document.querySelectorAll<HTMLButtonElement>('.font-scale-btn');
      const scaleToggle = document.getElementById('font-scale-toggle');
      const scaleOptions = document.getElementById('font-scale-options');

      function applyGlobalScale(scale: string) {
        document.documentElement.style.setProperty('--global-font-scale', scale);
        scaleButtons.forEach((btn) => {
          btn.classList.toggle('is-active', btn.dataset.scale === scale);
        });
      }

      applyGlobalScale(localStorage.getItem(SCALE_KEY) || '1');

      scaleToggle?.addEventListener('click', () => {
        const isOpen = !scaleOptions?.hidden;
        if (scaleOptions) scaleOptions.hidden = isOpen;
        scaleToggle.setAttribute('aria-expanded', String(!isOpen));
      });

      scaleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const scale = btn.dataset.scale || '1';
          localStorage.setItem(SCALE_KEY, scale);
          applyGlobalScale(scale);
          if (scaleOptions) scaleOptions.hidden = true;
          scaleToggle?.setAttribute('aria-expanded', 'false');
        });
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (scaleOptions && !scaleOptions.hidden && !scaleOptions.contains(target) && target !== scaleToggle && !scaleToggle?.contains(target)) {
          scaleOptions.hidden = true;
          scaleToggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
