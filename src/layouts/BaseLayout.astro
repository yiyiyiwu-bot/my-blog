---
import '../styles/global.css';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><rect width=%2216%22 height=%2216%22 fill=%22black%22/></svg>" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">{siteConfig.title}</a>
        <nav class="site-nav">
          {siteConfig.categories.map((cat) => (
            <a href={`/category/${encodeURIComponent(cat)}`}>{cat}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} {siteConfig.title}</span>
        <a href="/admin/">後台登入</a>
      </div>
    </footer>
  </body>
</html>
